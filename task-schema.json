{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "properties": {
    "completed": {
      "type": "boolean"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "user": {
      "type": "string"
    }
  },
  "required": [
    "completed",
    "created",
    "details",
    "title",
    "user"
  ]
}
